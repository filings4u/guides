{
  "manifest_version": 3,
  "name": "screenings4u Guide Builder",
  "version": "1.0.0",
  "description": "Record portal workflows, capture click-by-click screenshots, redact sensitive fields, and create branded how-to guides.",
  "permissions": ["activeTab", "tabs", "storage", "scripting", "unlimitedStorage", "downloads"],
  "host_permissions": ["https://*.screenings4u.com/*", "http://127.0.0.1/*", "http://localhost/*"],
  "action": {
    "default_title": "screenings4u Guide Builder",
    "default_popup": "popup.html"
  },
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["https://*.screenings4u.com/*", "http://127.0.0.1/*", "http://localhost/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "icons": {"16":"icon16.png","48":"icon48.png","128":"icon128.png"},
  "web_accessible_resources": [{"resources":["editor.html","editor.js","guide.css"],"matches":["<all_urls>"]}]
}
