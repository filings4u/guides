{
  "manifest_version": 3,
  "name": "screenings4u Guide Recorder",
  "version": "1.0.0",
  "description": "Record screenings4u portal workflows and capture a screenshot for each click.",
  "permissions": ["activeTab","tabs","storage","scripting","unlimitedStorage"],
  "host_permissions": ["https://*.screenings4u.com/*"],
  "background": {"service_worker":"background.js"},
  "action": {"default_title":"screenings4u Guide Recorder","default_popup":"popup.html"},
  "content_scripts": [{
    "matches":["https://*.screenings4u.com/*"],
    "js":["content.js"],
    "run_at":"document_start"
  }]
}