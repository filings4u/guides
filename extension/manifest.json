{
  "manifest_version": 3,
  "name": "screenings4u Guide Recorder",
  "version": "3.1.0",
  "description": "Record screenings4u portal workflows click-by-click and save complete screenshots directly to Guide Builder.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "unlimitedStorage",
    "scripting"
  ],
  "host_permissions": [
    "https://screenings4u.com/*",
    "https://*.screenings4u.com/*",
    "https://elpbnytpciqnbexiaebp.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "screenings4u Guide Recorder",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://screenings4u.com/*",
        "https://*.screenings4u.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "version_name": "3.1 Click-Perfect"
}